# Supabase 连接串：Supabase 控制台 -> Project Settings -> Database -> Connection string (URI)
# 用 Connection pooling (Transaction mode) 的连接串，端口 6543，并把 postgresql:// 改成 postgres://
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 服务端口
PORT=8787

# LLM API（M2 启用）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embedding API（M4 启用）—— 走 OpenAI 兼容协议；不填则检索降级为纯全文
# 默认 base 是 OpenAI；如走国内代理改 EMBEDDING_BASE_URL 即可
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM 默认 1536（与 schema embedding1536 一致；改 dim 需同步改 schema 与 SQL migration）
