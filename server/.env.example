# Supabase 连接串：Supabase 控制台 -> Project Settings -> Database -> Connection string (URI)
# 用 Connection pooling (Transaction mode) 的连接串，端口 6543，并把 postgresql:// 改成 postgres://
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 服务端口
PORT=8787

# LLM API（M2 启用）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embedding API（M4 启用）—— 走 OpenAI 兼容协议；不填则检索降级为纯全文
# 默认 base 是 OpenAI；国内推荐硅基流动 SiliconFlow（多模态 Qwen3-VL-Embedding，文+图统一向量空间）
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# EMBEDDING_DIMENSIONS=1536
# 注意：Qwen3 系列默认输出 4096 维，必须传 dimensions 压到表结构维度（1536），
#       否则 pgvector 写库报维度不匹配；EMBEDDING_DIMENSIONS 必须与 schema 的 EMBEDDING_DIM 同步
